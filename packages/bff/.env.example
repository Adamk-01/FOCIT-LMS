// === BFF Environment Configuration ===
// Copy this file to .env and fill in the values.

// --- Moodle Connection ---
MOODLE_BASE_URL=http://localhost:3001
MOODLE_WS_TOKEN=mock_dev_token_do_not_use_in_production

// --- Connection Pool ---
MOODLE_POOL_MAX_CONNECTIONS=50
MOODLE_POOL_CONNECT_TIMEOUT_MS=10000
MOODLE_POOL_BODY_TIMEOUT_MS=300000

// --- File Cache ---
CACHE_DIR=.cache/files
CACHE_MAX_SIZE_BYTES=2147483648
CACHE_TTL_MS=1800000

// --- Rate Limiting ---
RATE_LIMIT_LIST_MAX=30
RATE_LIMIT_DOWNLOAD_MAX=10
RATE_LIMIT_PREVIEW_MAX=20

// --- Auth ---
JWT_SECRET=dev_jwt_secret_change_in_production
JWT_ISSUER=focit-lms
JWT_AUDIENCE=focit-materials

// --- Server ---
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
