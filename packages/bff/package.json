{
  "name": "@focit/bff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FOCIT BFF Proxy — Express server that mediates between React frontend and Moodle",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch-path=src src/server.js",
    "start": "node src/server.js",
    "start:worker": "node src/worker.js",
    "dev:worker": "node --watch-path=src src/worker.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:seed": "node src/db/seed.js",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "test:connections": "node src/scripts/testConnections.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "undici": "^7.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@prisma/client": "^6.4.0",
    "prisma": "^6.4.0"
  },
  "directories": {
    "test": "test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
